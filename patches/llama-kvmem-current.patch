+                layer.value[(t * 48 + head) * 128 + col], layer.beta[t * 48 + head]);
+#pragma unroll
+        for (int r = 0; r < 4; ++r) {
+            s[r] = gdn_update_f32(s[r], k[r], decay, delta);
