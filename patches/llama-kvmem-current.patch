+bool llama_kv_cache_kvarn::can_seq_rm_logical(llama_seq_id seq_id, llama_pos p0, llama_pos p1) const {
+    if (seq_id < 0 || uint32_t(seq_id) >= n_seq_max) return false;
+    const auto & cells = metadata->get_cells(seq_id);
+    llama_pos logical_max = -1;
+    llama_pos model_begin = std::numeric_limits<llama_pos>::max();
+    const llama_pos begin = std::max<llama_pos>(0, p0);
+    const llama_pos end = p1 < 0 ? std::numeric_limits<llama_pos>::max() : p1;
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (cells.is_empty(i) || !cells.seq_has(i, seq_id)) continue;
+        const auto logical = cells.ext_get(i).logical_pos;
+        const auto row = logical >= 0 ? logical : cells.pos_get(i);
+        logical_max = std::max(logical_max, row);
+        if (row >= begin && row < end) model_begin = std::min(model_begin, cells.pos_get(i));
+    }
+    if (model_begin == std::numeric_limits<llama_pos>::max()) return true;
+    // 先检查逻辑后缀的压缩组边界，再检查可选精确尾缓存的回滚容量。
+    return llama_kvarn_can_remove_range(logical_max, begin, p1, KVAR_N_GROUP) &&
+        metadata->can_seq_rm(seq_id, begin == 0 ? 0 : model_begin, -1);
+}
