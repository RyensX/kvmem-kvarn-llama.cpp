+    float history[3];
+#pragma unroll
+    for (int i = 0; i < 3; ++i) {
+        const int source = n_keep + i;
+        history[i] = source < 3 ? layer.conv[channel * 3 + source]
+                                : layer.conv_input[(source - 3) * 10240 + channel];
+    }
+#pragma unroll
+    for (int i = 0; i < 3; ++i) {
+        layer.conv[channel * 3 + i] = history[i];
+    }
+}
